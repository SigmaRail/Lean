#!/bin/bash
#
# Build LEAN with ClickHouseDataProvider and create Docker image
# Usage: ./build-docker-image
#

set -e

echo "🔨 Building LEAN with ClickHouseDataProvider..."

# Clean previous builds
echo "Cleaning previous builds..."
dotnet clean -c Release

# Build LEAN in Release mode
echo "Building LEAN solution..."
dotnet build -c Release

echo "✅ LEAN build complete"

# Get git commit hash for tagging
GIT_HASH=$(git rev-parse --short=12 HEAD)

echo "🐳 Building multi-platform Docker image..."
# Use Buildx to publish a multi-platform image
docker buildx create --name lean-builder --use 2>/dev/null || docker buildx use lean-builder

docker buildx build \
  --platform linux/amd64,linux/arm64 \
  --build-arg LEAN_VERSION=${GIT_HASH} \
  -t ghcr.io/sigmarail/lean/lean-clickhouse:latest \
  -t ghcr.io/sigmarail/lean/lean-clickhouse:${GIT_HASH} \
  --push \
  .

echo "✅ Docker image built and pushed successfully"
echo ""
echo "📦 Image tags (linux/amd64 and linux/arm64):"
echo "  - ghcr.io/sigmarail/lean/lean-clickhouse:latest"
echo "  - ghcr.io/sigmarail/lean/lean-clickhouse:${GIT_HASH}"
echo ""
echo "Image is now available on GitHub Container Registry for GitHub Actions"
