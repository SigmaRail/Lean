#!/bin/bash
#
# Push LEAN Docker image to GitHub Container Registry
# Usage: ./push-docker-image
#

set -e

# Get git commit hash
GIT_HASH=$(git rev-parse --short=12 HEAD)

echo "🔐 Logging into GitHub Container Registry..."
GH_USERNAME="${GITHUB_ACTOR:-$(gh api user --jq .login)}"
if [ -n "${GITHUB_TOKEN:-}" ]; then
  printf '%s' "$GITHUB_TOKEN" | docker login ghcr.io -u "$GH_USERNAME" --password-stdin
else
  gh auth token | docker login ghcr.io -u "$GH_USERNAME" --password-stdin
fi

echo "📤 Pushing Docker images to ghcr.io..."

docker push ghcr.io/sigmarail/lean/lean-clickhouse:latest
docker push ghcr.io/sigmarail/lean/lean-clickhouse:${GIT_HASH}

echo "✅ Images pushed successfully"
echo ""
echo "📦 Published image tags:"
echo "  - ghcr.io/sigmarail/lean/lean-clickhouse:latest"
echo "  - ghcr.io/sigmarail/lean/lean-clickhouse:${GIT_HASH}"
echo ""
echo "To pull the image:"
echo "  docker pull ghcr.io/sigmarail/lean/lean-clickhouse:latest"
